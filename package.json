{
  "name": "@webship-js/moodle-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for learning sites on Moodle, a plugin for webship-js (Playwright and Cucumber): the session and the guest login, the dashboard and My courses, the course page with its sections, activities and completion, enrolment by the teacher and self enrolment with a key, the assignment (submit, grade), the quiz (attempt, submit, review), the forum (post, reply), the gradebook, the participants and their roles, the calendar, messages and notifications, and the site administration search and course management, waiting on the site's own signal for its pending JavaScript.",
  "main": "tests/step-definitions/moodle-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "moodle",
    "lms",
    "e-learning",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/moodle-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/moodle-steps/issues"
  },
  "homepage": "https://github.com/webship/moodle-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
